{
  "name": "planer-infra",
  "version": "0.1.0",
  "description": "Pulumi IaC for the Planer Sport backend and Keycloak on Azure",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "dependencies": {
    "@pulumi/azure-native": "^2.60.0",
    "@pulumi/azuread": "^6.0.0",
    "@pulumi/pulumi": "^3.130.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
